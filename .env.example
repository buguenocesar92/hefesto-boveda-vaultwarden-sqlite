# Configurar antes de arrancar. No versionar .env.
# Ver docs/operacion.md y scripts/configure.py.
VAULT_HOST=vault.tudominio.cl
OWNER_EMAIL=propietario@tudominio.cl
VOLUME_PREFIX=hefesto-boveda
# Registros abiertos por defecto: no. Crear cuentas por invitacion.
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=false
# Opcional: activar SMTP solo con proveedor y remitente reales.
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_FROM_NAME=Hefesto Boveda
# SMTP_ACCEPT_INVALID_CERTS=false
# SMTP_ACCEPT_INVALID_HOSTNAMES=false
# SMTP_DEBUG=false
